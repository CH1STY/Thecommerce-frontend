# Server-only. Read at request time by app/api/[...slug]/route.ts (never sent to the browser).
BACKEND_URL=http://thecommerce-backend:8080

# Number of reverse proxies in front of the Next.js server (0 = none). The BFF uses it to pick the shopper's real IP
# from X-Forwarded-For for the backend's per-IP OTP limit.
TRUSTED_PROXY_HOPS=0
